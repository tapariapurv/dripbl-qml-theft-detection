# Streamlit dashboard. Open http://<pi>:8501 from any device on the network.
[Unit]
Description=DRIPBL dashboard
After=dripbl-api.service
Wants=dripbl-api.service

[Service]
User=@USER@
WorkingDirectory=@DIR@
EnvironmentFile=-@DIR@/deploy/dripbl.env
ExecStart=@DIR@/.venv/bin/python3 -m streamlit run dashboard/app.py --server.address ${DRIPBL_HOST} --server.port ${DRIPBL_DASH_PORT}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
