# Copy to deploy/dripbl.env (install.sh does this) and edit. Read by all three services.
DRIPBL_HOST=0.0.0.0
DRIPBL_API_PORT=8000
DRIPBL_DASH_PORT=8501
DRIPBL_API_URL=http://127.0.0.1:8000
# Set a password before exposing the dashboard on a network:
DRIPBL_DASHBOARD_PASSWORD=
# Optional: fixed API key (otherwise generated into data/api_key on first start)
# DRIPBL_API_KEY=
# Optional: for Claude second opinions (or put it in Settings -> AI judge)
# ANTHROPIC_API_KEY=
